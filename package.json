{
  "name": "modern-leader",
  "private": true,
  "version": "0.1.0",
  "description": "Modern Leader (ML): a turn-based geopolitical grand-strategy web game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:download": "node tools/map/download.ts",
    "data:build": "node --max-old-space-size=8192 tools/map/build.ts",
    "data:validate": "node tools/validate/validate.ts",
    "data:flags": "node tools/countries/flags.ts",
    "data:stats": "node tools/countries/stats.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
